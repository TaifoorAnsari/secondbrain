generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==========================================
// USER
// ==========================================

model User {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  password String
  username String? @unique
  phone    String?
  bio      String?
  avatar   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes        Note[]
  entities     Entity[]
  timelines    Timeline[]
  diaryEntries DiaryEntry[]
}


// ==========================================
// NOTE
// ==========================================

model Note {
  id      String  @id @default(cuid())
  title   String
  content String
  pinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ==========================================
// ENTITY
// ==========================================

model Entity {
  id          String     @id @default(cuid())
  name        String
  type        EntityType
  description String?
  avatar      String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  timelineEntities TimelineEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==========================================
// TIMELINE
// ==========================================

model Timeline {
  id String @id @default(cuid())

  title          String
  description    String
  eventDate      DateTime
  showOnCalendar Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  entities TimelineEntity[]
}


// ==========================================
// TIMELINE ENTITY
// ==========================================

model TimelineEntity {
  timelineId String
  entityId   String

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([timelineId, entityId])
}


// ==========================================
// DIARY ENTRY
// ==========================================

model DiaryEntry {
  id String @id @default(cuid())

  title     String
  content   String
  mood      DiaryMood
  entryDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ==========================================
// ENUMS
// ==========================================

enum EntityType {
  PERSON
  COMPANY
}

enum DiaryMood {
  HAPPY
  SAD
  EXCITED
  CALM
  ANGRY
  ANXIOUS
  GRATEFUL
  NEUTRAL
}